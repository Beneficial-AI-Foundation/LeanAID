<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
<declaration>clock x, z;</declaration>
<template><name>PT</name>
<location id="P_0"><name>L0</name>
</location>
<location id="P_1"><name>L1</name>
</location>
<location id="P_2"><name>L2</name>
</location>
<init ref="P_0"/>
<transition><source ref="P_0"/><target ref="P_1"/>
<label kind="guard">x &gt;= 2</label>
<label kind="assignment">x = 0</label>
</transition>
<transition><source ref="P_1"/><target ref="P_2"/>
<label kind="guard">x &gt;= 3 &amp;&amp; z &lt;= 4</label>
</transition>
<transition><source ref="P_2"/><target ref="P_2"/>
</transition>
<transition><source ref="P_1"/><target ref="P_1"/>
</transition>
</template>
<system>P = PT();
system P;</system>
</nta>
