<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
<declaration>clock x;
int[0,2] n;
int[0,1] m;
broadcast chan b;</declaration>
<template><name>ST</name>
<location id="S_0"><name>A0</name>
</location>
<location id="S_1"><name>A1</name>
</location>
<init ref="S_0"/>
<transition><source ref="S_0"/><target ref="S_1"/>
<label kind="synchronisation">b!</label>
</transition>
<transition><source ref="S_1"/><target ref="S_1"/>
</transition>
</template>
<template><name>R1T</name>
<location id="R1_0"><name>B0</name>
</location>
<location id="R1_1"><name>B1</name>
</location>
<init ref="R1_0"/>
<transition><source ref="R1_0"/><target ref="R1_1"/>
<label kind="guard">n == 0</label>
<label kind="synchronisation">b?</label>
<label kind="assignment">n = 1</label>
</transition>
</template>
<template><name>R2T</name>
<location id="R2_0"><name>B0</name>
</location>
<location id="R2_1"><name>B1</name>
</location>
<init ref="R2_0"/>
<transition><source ref="R2_0"/><target ref="R2_1"/>
<label kind="guard">n == 1</label>
<label kind="synchronisation">b?</label>
<label kind="assignment">m = 1</label>
</transition>
</template>
<system>S = ST();
R1 = R1T();
R2 = R2T();
system S, R1, R2;</system>
</nta>
