theorem DB_44_general : ∀ p gs, DetermineBasalData.c31.input.profile = some p → DetermineBasalData.c31.input.glucose_status = some gs →
    (determineBasal DetermineBasalData.c31.input).units = none ∧
    ((∃ ct, DetermineBasalData.c31.input.currenttemp = some ct ∧ (ct.rate.js >ʲ profileCurrentBasal p) = true ∧
        (determineBasal DetermineBasalData.c31.input).rate = some (profileCurrentBasal p)) ∨
     (determineBasal DetermineBasalData.c31.input).rate = some 0 ∨
     ((determineBasal DetermineBasalData.c31.input).rate = none ∧ ∀ ct, DetermineBasalData.c31.input.currenttemp = some ct →
        (ct.rate.js >ʲ profileCurrentBasal p) = false)) := by
  intro p gs hp hgs
  have hp' := hp; have hgs' := hgs
  injection hp with hp; injection hgs with hgs; subst hp; subst hgs
  exact cgmError_no_increase hp' (by decide +kernel) hgs' (by decide +kernel)

