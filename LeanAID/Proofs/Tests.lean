def prefixL : List Char → List Char → Bool
  | [], _ => true
  | _ :: _, [] => false
  | a :: as, b :: bs => a == b && prefixL as bs

/-- The rest of `s` after the first occurrence of `p`. -/
def afterL (p : List Char) : List Char → Option (List Char)
  | [] => if p.isEmpty then some [] else none
  | c :: cs => if prefixL p (c :: cs) then some ((c :: cs).drop p.length) else afterL p cs

/-- The literal pieces occur in `s` in this order. -/
def piecesL (s : List Char) : List (List Char) → Bool
  | [] => true
  | p :: ps => match afterL p s with
    | some rest => piecesL rest ps
    | none => false

def reasonHas (r : Result) (ps : List String) : Bool := piecesL (r.reason.getD "").toList (ps.map String.toList)

/-- The prelude's result, for inputs on which it succeeds. -/
def preOf (inp : DBInputs) : Pre := match dbPrelude inp with | .ok p => p | .error _ => default

theorem okOf {inp : DBInputs} (h : (dbPrelude inp).isOk = true) : dbPrelude inp = .ok (preOf inp) := by
  unfold preOf; cases hp : dbPrelude inp <;> simp_all [Except.isOk, Except.toBool]

