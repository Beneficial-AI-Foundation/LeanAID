diff -ruN a/lib/determine-basal/determine-basal.js b/lib/determine-basal/determine-basal.js
--- a/lib/determine-basal/determine-basal.js
+++ b/lib/determine-basal/determine-basal.js
@@ -1192 +1192,36 @@
 module.exports = determine_basal;
+
+// LeanAID fix F-12 (not in oref0): with max_basal or max_daily_basal missing or not a
+// number, maxSafeBasal is NaN and no rate cap applies. Then run determine_basal with the cap
+// at the scheduled basal: a copy of the profile whose max_basal and max_daily_basal are
+// current_basal and whose safety multipliers are 1 (so getMaxSafeBasal is current_basal), and
+// microBolusAllowed false (no SMB). Low-glucose suspend and every other path stay oref0's. If
+// no rate is issued while a temp above current_basal runs, cancel it. Error results are
+// returned unchanged.
+var determine_basal_f12_inner = module.exports;
+module.exports = function determine_basal(glucose_status, currenttemp, iob_data, profile, autosens_data, meal_data, tempBasalFunctions, microBolusAllowed, reservoir_data, currentTime) {
+    if (typeof profile !== 'undefined' && typeof profile.current_basal !== 'undefined' && !(tempBasalFunctions.getMaxSafeBasal(profile) > 0)) {
+        var capped = Object.assign({}, profile, { max_basal: profile.current_basal, max_daily_basal: profile.current_basal, max_daily_safety_multiplier: 1, current_basal_safety_multiplier: 1 });
+        var rT = determine_basal_f12_inner(glucose_status, currenttemp, iob_data, capped, autosens_data, meal_data, tempBasalFunctions, false, reservoir_data, currentTime);
+        if (typeof rT.error === 'undefined') {
+            if (typeof rT.reason !== 'undefined') {
+                rT.reason += "; maxSafeBasal " + tempBasalFunctions.getMaxSafeBasal(profile) + " is not a positive number (max_basal or max_daily_basal missing or not a number): rate capped at current basal " + profile.current_basal + "U/hr, no SMB";
+            }
+            if (typeof rT.rate === 'undefined' && typeof currenttemp !== 'undefined' && currenttemp.rate > profile.current_basal) {
+                if (typeof rT.reason !== 'undefined') {
+                    rT.reason += "; canceling temp basal of " + currenttemp.rate + " above current basal " + profile.current_basal;
+                }
+                if (typeof rT.deliverAt === 'undefined') {
+                    rT.deliverAt = currentTime ? currentTime : new Date();
+                }
+                if (typeof rT.temp === 'undefined') {
+                    rT.temp = 'absolute';
+                }
+                rT.duration = 0;
+                rT.rate = 0;
+            }
+        }
+        return rT;
+    }
+    return determine_basal_f12_inner.apply(this, arguments);
+};
