+    var maxSafeBasalF12 = tempBasalFunctions.getMaxSafeBasal(profile);
+    if (!(typeof maxSafeBasalF12 === 'number' && isFinite(maxSafeBasalF12) && maxSafeBasalF12 > 0)) {
